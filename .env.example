# ==============================================================================
# FatSecret MCP Server - Environment Configuration Template
# ==============================================================================

# Server Network & Storage
PORT=3000
HOST=0.0.0.0
FATSECRET_CONFIG_DIR=/data

# Authentication Bypass (Set to true ONLY for local debugging without Cloudflare Access)
SKIP_AUTH=false

# Cloudflare Access Configuration (Managed OAuth JWT Verification)
# Team domain: e.g. "myteam.cloudflareaccess.com" or "myteam"
CF_ACCESS_TEAM_DOMAIN=your-team-name.cloudflareaccess.com
# Application Audience (AUD) tag: Available in Cloudflare Zero Trust Dashboard -> Access -> Applications
CF_ACCESS_AUD=your-application-audience-tag

# FatSecret Platform API Credentials (https://platform.fatsecret.com/ -> My Account -> API Keys)
FATSECRET_CLIENT_ID=your_client_id
FATSECRET_CLIENT_SECRET=your_client_secret
FATSECRET_CONSUMER_SECRET=your_consumer_secret
