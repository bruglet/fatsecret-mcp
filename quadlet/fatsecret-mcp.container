[Unit]
Description=FatSecret MCP Streamable HTTP Server
After=network-online.target

[Container]
Image=ghcr.io/bruglet/fatsecret-mcp:latest
AutoUpdate=registry
EnvironmentFile=%h/.config/fatsecret-mcp/.env
Volume=%h/.config/fatsecret-mcp/data:/data:Z
PublishPort=127.0.0.1:3000:3000

[Install]
WantedBy=default.target
